@plantId = 6203ddf0-52a1-4251-bafa-193f694d7601
@simulationId = 9305d20d-9660-43bc-88b1-841727adb8aa

@deleteSimulationId = 9e5d4475-ae83-442a-b154-2cd0195dba4b

### Get All Simulations
GET http://localhost:8080/api/v1/simulations

### Get Simulations By Plant
GET http://localhost:8080/api/v1/simulations?plantId={{plantId}}

### Get Simulation By ID
GET http://localhost:8080/api/v1/simulations/{{simulationId}}

### Get Simulations By Status
GET http://localhost:8080/api/v1/simulations?status=PAUSED

### Get Simulations By Plant And Status
GET http://localhost:8080/api/v1/simulations?plantId={{plantId}}&status=IDLE

### Create Simulation
# Requires an authenticated ADMIN user.
POST http://localhost:8080/api/v1/simulations
Content-Type: application/json

{
	"plantId": "{{plantId}}",
	"name": "Anaerobic Digestion Simulation",
	"status": "IDLE",
	"updateIntervalMs": 1000,
	"noiseFactor": 0.05
}

### Create Simulation With Defaults
# Defaults: status=IDLE, updateIntervalMs=1000, noiseFactor=0.
POST http://localhost:8080/api/v1/simulations
Content-Type: application/json

{
	"plantId": "{{plantId}}",
	"name": "Default Plant Simulation"
}

### Update Simulation
# Requires an authenticated ADMIN user.
PUT http://localhost:8080/api/v1/simulations/{{simulationId}}
Content-Type: application/json

{
	"plantId": "{{plantId}}",
	"name": "Anaerobic Digestion Simulation Upgrade",
	"updateIntervalMs": 2000,
	"noiseFactor": 0.1
}

### Update Simulation Tuning Only
# Requires an authenticated ADMIN user.
PUT http://localhost:8080/api/v1/simulations/{{simulationId}}
Content-Type: application/json

{
	"updateIntervalMs": 1500,
	"noiseFactor": 0.03
}

### Start Simulation
# Requires an authenticated ADMIN or OPERATOR user.
POST http://localhost:8080/api/v1/simulations/{{simulationId}}/start

### Pause Simulation
# Requires an authenticated ADMIN or OPERATOR user.
POST http://localhost:8080/api/v1/simulations/{{simulationId}}/pause

### Stop Simulation
# Requires an authenticated ADMIN or OPERATOR user.
POST http://localhost:8080/api/v1/simulations/{{simulationId}}/stop

### Delete Simulation
# Requires an authenticated ADMIN user.
# Simulation must be IDLE or STOPPED before deletion.
DELETE http://localhost:8080/api/v1/simulations/{{deleteSimulationId}}
Content-Type: application/json

{
	"action": "delete"
}
