  "plants": { "owns": ["internal/plants/**/*.go"] },
  "process-units": { "owns": ["internal/process_units/**/*.go"] },
  "devices": { "owns": ["internal/devices/**/*.go"] },
  "tags": { "owns": ["internal/tags/**/*.go"] },
  "models": { "owns": ["internal/models/**/*.go"] },
  "tag-readings": { "owns": ["internal/tag_readings/**/*.go"] },
  "alert-rules": { "owns": ["internal/alert_rules/**/*.go"] },
  "alerts": { "owns": ["internal/alerts/**/*.go"] },
  "audit-logs": { "owns": ["internal/audit_logs/**/*.go"] },
  "simulations": { "owns": ["internal/simulations/**/*.go"] },
  "scenarios": { "owns": ["internal/simulation_scenarios/**/*.go"] },
  "simulation-engine": { "owns": ["internal/simulation_engine/**/*.go"] },
